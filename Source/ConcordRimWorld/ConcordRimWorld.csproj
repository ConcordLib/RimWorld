<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ConcordRimWorld</AssemblyName>
    <RootNamespace>Concord.RimWorld</RootNamespace>
    <OutputPath>../../Current/Assemblies</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <ConcordCoreDir>$(MSBuildThisFileDirectory)../../../Core</ConcordCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GUI and GUIContent, which the main menu version readout draws through. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    <!-- The API surface the patches compile against. Keep in step with the Core checkout that
         StageConcordRuntime builds, or the mod compiles against types the runtime does not have. -->
    <PackageReference Include="Concord.Ref" Version="0.14.0" PrivateAssets="all" />
    <!-- Referenced only to stage the file. ConcordRimWorld never binds to Concord.Harmony at
         compile time: it talks to IForeignPatchHost and side-loads the dll at runtime, because
         RimWorld does not scan Current/Bridge for mod assemblies. -->
    <PackageReference Include="Concord.Harmony" Version="0.14.0" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <!-- HarmonyProbe loads Current/Bridge/Concord.Harmony.dll by path after it finds a
       supported Harmony, so the package's net472 asset has to land there. -->
  <Target Name="StageHarmonyHost" AfterTargets="Build">
    <Copy SourceFiles="$(PkgConcord_Harmony)/lib/net472/Concord.Harmony.dll" DestinationFolder="$(MSBuildThisFileDirectory)../../Current/Bridge" SkipUnchangedFiles="true" />
  </Target>

  <!-- Builds Core in its own MSBuild process, so its MinVer version cannot be stamped onto this
       assembly, then stages the result the mod actually loads at runtime. Skipped when there is no
       Core checkout beside this repo, which is how CI stages the published runtime instead. -->
  <Target Name="StageConcordRuntime" AfterTargets="Build" Condition="Exists('$(ConcordCoreDir)/Concord.slnx')">
    <Exec Command="dotnet build &quot;$(ConcordCoreDir)/Concord.slnx&quot; -c Release --verbosity quiet" />
    <Error Condition="!Exists('$(ConcordCoreDir)/Assemblies/net472/Concord.dll')"
           Text="Core built but produced no Assemblies/net472/Concord.dll at $(ConcordCoreDir)." />
    <Copy SourceFiles="$(ConcordCoreDir)/Assemblies/net472/Concord.dll"
          DestinationFiles="$(MSBuildThisFileDirectory)../../Current/Assemblies/0Concord.dll"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="ConcordRimWorld.Tests" />
  </ItemGroup>

</Project>
