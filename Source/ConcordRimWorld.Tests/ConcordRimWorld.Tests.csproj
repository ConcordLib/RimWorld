<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <ConcordCoreDir>$(MSBuildThisFileDirectory)../../../Core</ConcordCoreDir>
    <ModVersionDir>$(MSBuildThisFileDirectory)../../$(GameVersion)</ModVersionDir>
    <UsePinnedConcord Condition="!Exists('$(ConcordCoreDir)/Concord.slnx')">true</UsePinnedConcord>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="xunit.runner.console" Version="2.9.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(GameTfm)' == 'net472'" />
    <PackageReference Include="Concord.Runtime" Version="$(ConcordVersion)" Condition="'$(UsePinnedConcord)' == 'true'" />
    <PackageReference Include="Lib.Harmony" Version="3.0.*-*" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePinnedConcord)' != 'true'">
    <Reference Include="Concord">
      <HintPath>$(ConcordCoreDir)/Assemblies/$(GameTfm)/Concord.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ConcordRimWorld/ConcordRimWorld.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GamecrateRefs)/Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
